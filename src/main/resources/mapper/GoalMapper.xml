<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.udemy.hello.mapper.GoalMapper">

    <!-- mybatis.configuration.map-underscore-to-camel-case=true だが、モデルのフィールド名は
         既存Learningと同じくDB列名そのまま(snake_case)のため、自動キャメル変換を避けて
         明示的にresultMapで対応させる -->
    <resultMap id="Goal" type="Goal">
        <id property="id" column="id" />
        <result property="title" column="title" />
        <result property="description" column="description" />
        <result property="status" column="status" />
        <result property="created_at" column="created_at" />
        <result property="delete_flg" column="delete_flg" />
        <result property="user_id" column="user_id" />
    </resultMap>

    <select id="findAll" resultMap="Goal">
        SELECT *
        FROM goals
        WHERE delete_flg = 0
          AND user_id = #{user_id}
        ORDER BY id ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO goals
        (title, description, status, created_at, user_id)
        VALUES
        (#{title}, #{description}, #{status}, #{created_at}, #{user_id});
    </insert>

    <!-- WHERE に user_id も含めることで、本人が作成した目標以外は更新されない（0件のまま）ようにする -->
    <update id="update">
        UPDATE goals
        SET title = #{title},
            description = #{description},
            status = #{status}
        WHERE id = #{id} AND user_id = #{user_id};
    </update>

    <!-- WHERE に user_id も含めることで、本人が作成した目標以外は削除されない（0件のまま）ようにする -->
    <update id="delete">
        UPDATE goals
        SET delete_flg = 1
        WHERE id = #{id} AND user_id = #{user_id};
    </update>

</mapper>
